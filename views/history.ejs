<!-- Page header -->
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/pets" class="text-white opacity-75 text-decoration-none" style="font-size:.9rem;">
            <i class="bi bi-arrow-left me-1"></i>Volver a Pacientes
        </a>
    </div>
    <h1 class="h3 mb-1"><i class="bi bi-journal-medical me-2"></i>Expediente Médico — <%= pet.name %></h1>
    <p>Dueño: <%= pet.owner_name %> &nbsp;|&nbsp; Historial cronológico de visitas (solo lectura)</p>
</div>

<% if (appointments.length === 0) { %>
<div class="card p-5 text-center">
    <div style="font-size:3.5rem;">📋</div>
    <h5 class="mt-3 text-muted">No hay visitas registradas para <%= pet.name %></h5>
    <p class="text-muted">Las citas aparecerán aquí una vez sean agendadas.</p>
</div>
<% } else { %>

<!-- Read-only notice -->
<div class="d-flex align-items-center gap-2 p-3 rounded-3 mb-4"
     style="background:#fff8e1;border:1.5px solid #ffe082;">
    <i class="bi bi-lock" style="color:#f9a825;font-size:1.1rem;"></i>
    <div style="font-size:.88rem;">
        <strong style="color:#f57f17;">Expediente de solo lectura</strong>
        <span class="text-muted"> — Los registros médicos históricos no pueden ser modificados</span>
    </div>
</div>

<!-- Timeline -->
<div class="position-relative">
    <!-- Vertical line -->
    <div style="position:absolute;left:24px;top:0;bottom:0;width:3px;background:var(--border);border-radius:2px;z-index:0;"></div>

    <% appointments.forEach((appt, index) => { %>
    <div class="d-flex gap-3 mb-4 position-relative" style="z-index:1;">
        <!-- Timeline dot -->
        <div class="flex-shrink-0" style="width:48px;display:flex;justify-content:center;padding-top:1.5rem;">
            <div style="width:14px;height:14px;border-radius:50%;border:3px solid var(--primary);background:var(--surface);"></div>
        </div>

        <!-- Card -->
        <div class="card flex-grow-1" style="cursor:default;">
            <div style="height:4px;background:linear-gradient(90deg,var(--primary),var(--success));border-radius:var(--radius) var(--radius) 0 0;"></div>
            <div class="card-body p-4">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="fw-bold" style="font-size:1.05rem;">
                            <i class="bi bi-calendar-event me-1" style="color:var(--primary);"></i>
                            Visita #<%= index + 1 %>
                        </div>
                        <div class="text-muted" style="font-size:.82rem;">
                            <i class="bi bi-clock me-1"></i><%= appt.appointment_date %>
                        </div>
                    </div>
                    <span class="badge rounded-pill"
                          style="background:var(--primary-soft);color:var(--primary);font-size:.72rem;font-weight:600;">
                        <%= appt.status %>
                    </span>
                </div>

                <!-- Medical data grid -->
                <div class="row g-3">
                    <!-- Servicio -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:var(--bg);border:1px solid var(--border);">
                            <div class="text-muted small mb-1"><i class="bi bi-scissors me-1"></i>Servicio</div>
                            <div class="fw-semibold" style="font-size:.92rem;"><%= appt.service %></div>
                        </div>
                    </div>

                    <!-- Peso -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:var(--bg);border:1px solid var(--border);">
                            <div class="text-muted small mb-1"><i class="bi bi-speedometer me-1"></i>Peso</div>
                            <div class="fw-semibold" style="font-size:.92rem;">
                                <%= appt.weight ? appt.weight + ' kg' : 'No registrado' %>
                            </div>
                        </div>
                    </div>

                    <!-- Diagnóstico -->
                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background:var(--bg);border:1px solid var(--border);">
                            <div class="text-muted small mb-1"><i class="bi bi-clipboard2-pulse me-1"></i>Diagnóstico</div>
                            <div style="font-size:.92rem;">
                                <%= appt.diagnosis || 'Sin diagnóstico registrado' %>
                            </div>
                        </div>
                    </div>

                    <!-- Medicina recetada -->
                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background:var(--bg);border:1px solid var(--border);">
                            <div class="text-muted small mb-1"><i class="bi bi-capsule me-1"></i>Medicina Recetada</div>
                            <div style="font-size:.92rem;">
                                <%= appt.prescribed_medicine || 'Ninguna' %>
                            </div>
                        </div>
                    </div>

                    <!-- Notas médicas -->
                    <% if (appt.medical_notes) { %>
                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                            <div class="text-muted small mb-1"><i class="bi bi-file-medical me-1"></i>Notas Médicas</div>
                            <div style="font-size:.92rem;"><%= appt.medical_notes %></div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <% }) %>
</div>
<% } %>
