<!-- Page header -->
<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-heart-pulse me-2"></i>Pacientes</h1>
        <p>Selecciona un paciente para ver su expediente médico completo</p>
    </div>
</div>

<% if (pets.length === 0) { %>
<div class="card p-5 text-center">
    <div style="font-size:3.5rem;">🐾</div>
    <h5 class="mt-3 text-muted">No hay pacientes registrados</h5>
</div>
<% } else { %>
<div class="row g-3">
    <% pets.forEach(pet => { %>
    <div class="col-md-6 col-lg-4">
        <a href="/pets/<%= pet.id %>/history" class="text-decoration-none">
            <div class="card h-100" style="cursor:pointer;">
                <div style="height:5px;background:linear-gradient(90deg,var(--success),var(--primary));border-radius:var(--radius) var(--radius) 0 0;"></div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:50px;height:50px;background:var(--primary-soft);border-radius:12px;
                                    display:flex;align-items:center;justify-content:center;font-size:1.5rem;">
                            🐶
                        </div>
                        <div>
                            <div class="fw-bold" style="font-size:1.1rem;color:var(--text);"><%= pet.name %></div>
                            <div class="text-muted" style="font-size:.85rem;">
                                <i class="bi bi-person me-1"></i><%= pet.owner_name %>
                            </div>
                        </div>
                        <div class="ms-auto">
                            <i class="bi bi-chevron-right" style="color:var(--primary);font-size:1.2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <% }) %>
</div>
<% } %>
