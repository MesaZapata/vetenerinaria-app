<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PeluCan Spa — <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --primary:     #6c5ce7;
            --primary-dark:#5a4bd1;
            --primary-soft:#ede9ff;
            --accent:      #fd79a8;
            --success:     #00b894;
            --warning:     #fdcb6e;
            --danger:      #e17055;
            --bg:          #f4f3ff;
            --surface:     #ffffff;
            --text:        #2d3436;
            --text-muted:  #636e72;
            --border:      #e8e5ff;
            --shadow-sm:   0 2px 8px rgba(108,92,231,.08);
            --shadow-md:   0 8px 24px rgba(108,92,231,.12);
            --shadow-lg:   0 16px 48px rgba(108,92,231,.16);
            --radius:      14px;
            --radius-sm:   8px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Navbar ── */
        .navbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            padding: .75rem 0;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--primary) !important;
            display: flex;
            align-items: center;
            gap: .45rem;
        }
        .navbar-brand .brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }
        .nav-link {
            color: var(--text-muted) !important;
            font-weight: 500;
            padding: .4rem .75rem !important;
            border-radius: var(--radius-sm);
            transition: all .2s;
        }
        .nav-link:hover, .nav-link.active {
            color: var(--primary) !important;
            background: var(--primary-soft);
        }
        .user-badge {
            display: flex; align-items: center; gap: .5rem;
            background: var(--primary-soft);
            border: 1px solid var(--border);
            border-radius: 50px;
            padding: .3rem .75rem .3rem .4rem;
            font-size: .82rem;
            font-weight: 500;
            color: var(--primary);
        }
        .user-badge .avatar {
            width: 26px; height: 26px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .75rem;
            color: white;
        }
        .role-tag {
            font-size: .68rem;
            padding: .15rem .5rem;
            border-radius: 50px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
        }
        .role-veterinario { background: #d1f5e8; color: #00856f; }
        .role-admin       { background: #e0d9ff; color: #5a4bd1; }
        .role-recepcionista { background: #fff0d6; color: #b97d00; }

        /* ── Buttons ── */
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 600;
            padding: .55rem 1.25rem;
            transition: all .25s;
            box-shadow: 0 4px 12px rgba(108,92,231,.3);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(108,92,231,.4);
            background: linear-gradient(135deg, var(--primary-dark), #4a3bc1);
        }
        .btn-outline-secondary {
            border-radius: var(--radius-sm);
            font-weight: 500;
            padding: .4rem 1rem;
        }

        /* ── Cards ── */
        .card {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            background: var(--surface);
            transition: box-shadow .25s, transform .25s;
        }
        .card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

        /* ── Main & Footer ── */
        main { flex: 1; padding-bottom: 2rem; }
        .footer {
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 1.25rem 0;
            text-align: center;
            font-size: .85rem;
            color: var(--text-muted);
        }

        /* ── Form controls ── */
        .form-control, .form-select {
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: .6rem .9rem;
            transition: border-color .2s, box-shadow .2s;
            font-family: 'Outfit', sans-serif;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(108,92,231,.15);
        }
        .form-label { font-weight: 600; font-size: .9rem; margin-bottom: .4rem; }

        /* ── Page header ── */
        .page-header {
            background: linear-gradient(135deg, var(--primary) 0%, #a29bfe 100%);
            border-radius: var(--radius);
            padding: 2rem 2.5rem;
            color: white;
            margin-bottom: 2rem;
        }
        .page-header h1 { font-weight: 700; margin-bottom: .25rem; }
        .page-header p  { opacity: .85; margin: 0; font-size: .95rem; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">
            <div class="brand-icon">🐾</div>
            PeluCan Spa
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                <li class="nav-item">
                    <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Inicio</a>
                </li>
                <% if (user && (user.role === 'veterinario' || user.role === 'admin')) { %>
                <li class="nav-item">
                    <a class="nav-link" href="/create"><i class="bi bi-calendar-plus me-1"></i>Agendar Cita</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/pets"><i class="bi bi-journal-medical me-1"></i>Expedientes</a>
                </li>
                <% } %>
                <% if (user) { %>
                <li class="nav-item">
                    <a class="nav-link" href="/pets/new"><i class="bi bi-plus-circle me-1"></i>Nueva Mascota</a>
                </li>
                <% } %>

                <% if (user) { %>
                <li class="nav-item ms-2">
                    <div class="user-badge">
                        <div class="avatar"><i class="bi bi-person-fill"></i></div>
                        <div>
                            <div style="line-height:1.1"><%= user.full_name %></div>
                            <span class="role-tag role-<%= user.role %>"><%= user.role %></span>
                        </div>
                    </div>
                </li>
                <li class="nav-item ms-2">
                    <form action="/logout" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Salir
                        </button>
                    </form>
                </li>
                <% } else { %>
                <li class="nav-item ms-2">
                    <a class="btn btn-primary btn-sm px-3" href="/login">
                        <i class="bi bi-lock me-1"></i>Iniciar Sesión
                    </a>
                </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    <%- body %>
</main>

<footer class="footer">
    <div class="container">
        <i class="bi bi-heart-fill text-danger me-1" style="font-size:.7rem;"></i>
        &copy; 2026 PeluCan Spa &mdash; Gestión de Citas Veterinarias
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
