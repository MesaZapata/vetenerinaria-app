<!-- Page header -->
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/" class="text-white opacity-75 text-decoration-none" style="font-size:.9rem;">
            <i class="bi bi-arrow-left me-1"></i>Volver al panel
        </a>
    </div>
    <h1 class="h3 mb-1"><i class="bi bi-calendar-plus me-2"></i>Agendar Nueva Cita</h1>
    <p>Completa los datos médicos de la cita. Solo veterinarios autorizados pueden registrar este formulario.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card">
            <!-- Role notice -->
            <div class="px-4 pt-4 pb-0">
                <div class="d-flex align-items-center gap-2 p-3 rounded-3 mb-1"
                     style="background:var(--primary-soft);border:1.5px solid var(--border);">
                    <i class="bi bi-shield-check" style="color:var(--primary);font-size:1.1rem;"></i>
                    <div style="font-size:.88rem;">
                        <strong style="color:var(--primary);">Zona médica protegida</strong>
                        <span class="text-muted"> — Acceso exclusivo para veterinarios y administradores</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form action="/create" method="POST">

                    <!-- Mascota -->
                    <div class="mb-4">
                        <label for="pet_id" class="form-label">
                            <i class="bi bi-heart me-1" style="color:var(--accent);"></i>Mascota
                        </label>
                        <select class="form-select" id="pet_id" name="pet_id" required>
                            <option value="" disabled selected>Selecciona una mascota…</option>
                            <% pets.forEach(pet => { %>
                            <option value="<%= pet.id %>"><%= pet.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Servicio / campo médico -->
                    <div class="mb-4">
                        <label for="service" class="form-label">
                            <i class="bi bi-scissors me-1" style="color:var(--primary);"></i>Servicio / Procedimiento médico
                        </label>
                        <input type="text" class="form-control" id="service" name="service"
                               placeholder="Ej: Vacunación, Corte de pelo, Revisión general…"
                               required>
                    </div>

                    <!-- Notas médicas -->
                    <div class="mb-4">
                        <label for="medical_notes" class="form-label">
                            <i class="bi bi-file-medical me-1" style="color:var(--success);"></i>Notas del historial médico
                        </label>
                        <textarea class="form-control" id="medical_notes" name="medical_notes"
                                  rows="3" placeholder="Alergias, condiciones previas, observaciones…"></textarea>
                    </div>

                    <!-- Diagnóstico -->
                    <div class="mb-4">
                        <label for="diagnosis" class="form-label">
                            <i class="bi bi-clipboard2-pulse me-1" style="color:var(--danger);"></i>Diagnóstico
                        </label>
                        <textarea class="form-control" id="diagnosis" name="diagnosis"
                                  rows="2" placeholder="Diagnóstico del paciente…"></textarea>
                    </div>

                    <!-- Peso y Medicina -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label for="weight" class="form-label">
                                <i class="bi bi-speedometer me-1" style="color:var(--warning);"></i>Peso (kg)
                            </label>
                            <input type="number" class="form-control" id="weight" name="weight"
                                   step="0.1" min="0" placeholder="Ej: 12.5">
                        </div>
                        <div class="col-md-8">
                            <label for="prescribed_medicine" class="form-label">
                                <i class="bi bi-capsule me-1" style="color:var(--accent);"></i>Medicina Recetada
                            </label>
                            <input type="text" class="form-control" id="prescribed_medicine" name="prescribed_medicine"
                                   placeholder="Medicamentos recetados…">
                        </div>
                    </div>

                    <!-- Fecha -->
                    <div class="mb-4">
                        <label for="appointment_date" class="form-label">
                            <i class="bi bi-calendar-event me-1" style="color:var(--primary);"></i>Fecha y hora
                        </label>
                        <input type="datetime-local" class="form-control" id="appointment_date"
                               name="appointment_date" required>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 justify-content-end border-top pt-4 mt-2">
                        <a href="/" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-5">
                            <i class="bi bi-check2 me-1"></i>Guardar Cita
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
